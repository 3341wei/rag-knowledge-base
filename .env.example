# ============================================================
# 环境变量模板
# 使用方法：复制本文件为 .env，然后填入你自己的密钥
#   cp .env.example .env
# 注意：.env 含真实密钥，已被 .gitignore 忽略，绝不要提交或分享
# ============================================================

# ---------------- 运行环境 ----------------
# development：本地开发，缺少密钥也能启动（对应接口返回 503）
# production ：生产环境，启动时强制校验密钥，缺失直接失败
APP_ENV=development

HOST=0.0.0.0
PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志格式：text（本地易读） / json（生产便于采集）
LOG_FORMAT=text

# 允许跨域的前端来源，逗号分隔；留空表示只允许同源访问
# 例如：https://kb.example.com,https://admin.example.com
CORS_ORIGINS=


# ---------------- 访问控制（强烈建议配置） ----------------
# 允许调用 /api/* 的访问密钥，逗号分隔支持多把密钥轮换
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 留空：development 下跳过鉴权（仅适合本机调试），production 下禁止启动
API_KEYS=

# 普通问答限流：窗口内允许的请求数 / 窗口秒数
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# 重建索引限流（昂贵操作，单独更严格）
INGEST_RATE_LIMIT_REQUESTS=3
INGEST_RATE_LIMIT_WINDOW_SECONDS=3600


# ---------------- LLM（对话与生成） ----------------
# DeepSeek 开放平台申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-请替换为你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
# 外部接口失败重试次数（不含首次调用）
LLM_MAX_RETRIES=2


# ---------------- Embedding（向量化） ----------------
# 硅基流动控制台申请：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=sk-请替换为你的硅基流动密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBED_MODEL=BAAI/bge-large-zh-v1.5

# 单次 embedding 请求的最大文本条数（模型有批量上限）
EMBED_BATCH_SIZE=32

# 外部 HTTP 接口超时（秒）
HTTP_TIMEOUT_SECONDS=30


# ---------------- Rerank（重排序） ----------------
RERANK_MODEL=BAAI/bge-reranker-v2-m3


# ---------------- 数据与索引路径 ----------------
# 相对路径基于项目根目录
DATA_DIR=./data
CHROMA_DIR=./chroma_db


# ---------------- 切分与检索参数 ----------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 纯 RAG 最终返回的片段数
TOP_K=3

# 混合检索粗召回候选数
RECALL_K=20
# Rerank 精排后保留数
RERANK_TOP_K=3

# 启动时预热 BM25 索引（数据量大时可关闭以加快冷启动）
WARMUP_BM25=true


# ---------------- 其他 ----------------
# 是否启用 SSE 流式接口（/api/*/stream）
STREAM_ENABLED=true
